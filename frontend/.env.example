# Copy to .env.local and fill in for production.
# The tracking snippets and canonical URLs only activate when these are present.

# Used as the canonical base URL for SEO, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://artha-web-services.vercel.app/

# Google Analytics 4 — set to enable gtag, leave empty to omit.
NEXT_PUBLIC_GA_ID=

# Plausible analytics domain — set to enable the script, leave empty to omit.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Backend API server (Hono) that the project form posts to. Defaults to the
# local backend in dev if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000